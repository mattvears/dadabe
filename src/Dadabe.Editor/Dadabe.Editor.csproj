  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dadabe.Core\Dadabe.Core.csproj" />
    <ProjectReference Include="..\Dadabe.Fretboard\Dadabe.Fretboard.csproj" />
  </ItemGroup>

</Project>
