@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.ScaleModel>>

<div class="list-header">
  <span></span>
  <wa-button hx-get="/api/reference/scales/new" hx-target="#dialog-container" hx-swap="innerHTML">
    <wa-icon slot="prefix" name="plus"></wa-icon> New
  </wa-button>
</div>

@if (Model.Count == 0)
{
  <p class="empty-state">No scales yet.</p>
}
else
{
  <table>
    <thead><tr><th>Name</th><th>Notes</th><th>Intervals</th><th></th></tr></thead>
    <tbody>
      @foreach (var s in Model)
      {
        <tr id="scale-@s.Slug">
          <td>@s.Name</td>
          <td>@string.Join(", ", s.Notes)</td>
          <td>@string.Join(", ", s.Intervals)</td>
          <td class="no-wrap">
            <wa-button size="small" variant="neutral"
                    hx-get="/api/reference/scales/@s.Slug/edit"
                    hx-target="#dialog-container" hx-swap="innerHTML">
              <wa-icon name="pencil"></wa-icon>
            </wa-button>
            <wa-button size="small" variant="danger"
                    hx-delete="/api/reference/scales/@s.Slug"
                    hx-target="#scale-@s.Slug" hx-swap="outerHTML"
                    hx-confirm="Delete '@s.Name'?">
              <wa-icon name="trash"></wa-icon>
            </wa-button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
