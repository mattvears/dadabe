@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.TuningModel>>

@if (Model.Count == 0)
{
  <p class="italic">No tunings yet.</p>
}
else
{
  <table class="border">
    <thead>
      <tr><th>Name</th><th>Strings</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var t in Model)
      {
        <tr id="tuning-@t.Slug">
          <td>@t.Name</td>
          <td>@string.Join(", ", t.Strings)</td>
          <td class="no-wrap">
            <button class="small border"
                    hx-get="/api/tunings/@t.Slug/edit"
                    hx-target="#dialog-container"
                    hx-swap="innerHTML">
              <i>edit</i>
            </button>
            <button class="small border error"
                    hx-delete="/api/tunings/@t.Slug"
                    hx-target="#tuning-@t.Slug"
                    hx-swap="outerHTML"
                    hx-confirm="Delete '@t.Name'?">
              <i>delete</i>
            </button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
