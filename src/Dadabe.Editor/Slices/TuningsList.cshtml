@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.TuningModel>>

@if (Model.Count == 0)
{
  <p class="empty-state">No tunings yet.</p>
}
else
{
  <table>
    <thead>
      <tr><th>Name</th><th>Strings</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var t in Model)
      {
        <tr id="tuning-@t.Slug">
          <td>@t.Name</td>
          <td>@string.Join(", ", t.Strings)</td>
          <td class="no-wrap">
            <wa-button size="small" variant="neutral"
                    hx-get="/api/tunings/@t.Slug/edit"
                    hx-target="#dialog-container"
                    hx-swap="innerHTML">
              <wa-icon name="pencil"></wa-icon>
            </wa-button>
            <wa-button size="small" variant="danger"
                    hx-delete="/api/tunings/@t.Slug"
                    hx-target="#tuning-@t.Slug"
                    hx-swap="outerHTML"
                    hx-confirm="Delete '@t.Name'?">
              <wa-icon name="trash"></wa-icon>
            </wa-button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
