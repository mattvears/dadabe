@inherits RazorSlices.RazorSlice<Dadabe.Editor.Services.TuningModel?>

@{
  var isNew  = Model is null;
  var slug   = Model?.Slug ?? string.Empty;
  var method = isNew ? "post" : "put";
  var action = isNew ? "/api/tunings" : $"/api/tunings/{slug}";
}

<wa-dialog id="tuning-dialog" open label="@(isNew ? "New Tuning" : $"Edit: {Model!.Name}")">
  <form hx-@method="@action"
        hx-target="#tuning-list"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) document.getElementById('tuning-dialog').hide()">

    <div class="form-field">
      <wa-input label="Name" name="name" value="@(Model?.Name ?? "")" required
                @(isNew ? "" : "readonly")></wa-input>
    </div>

    <p>Strings (low to high)</p>
    <div id="string-list">
      @{
        var strings = Model?.Strings ?? [];
        for (int i = 0; i < strings.Count; i++)
        {
          <div class="list-item string-item" id="string-item-@i">
            <wa-input name="strings" value="@strings[i]" placeholder="e.g. E2" style="flex:1"></wa-input>
            <wa-button type="button" variant="neutral" size="small"
                       onclick="this.closest('.string-item').remove()">
              <wa-icon name="xmark"></wa-icon>
            </wa-button>
          </div>
        }
      }
    </div>
    <wa-button type="button" variant="neutral" size="small" onclick="addString()">
      <wa-icon slot="prefix" name="plus"></wa-icon> Add string
    </wa-button>

    <div slot="footer" class="dialog-footer">
      <wa-button variant="neutral" onclick="document.getElementById('tuning-dialog').hide()">Cancel</wa-button>
      <wa-button type="submit" variant="brand">Save</wa-button>
    </div>
  </form>
</wa-dialog>

<script>
function addString() {
  var list = document.getElementById('string-list');
  var idx = list.children.length;
  var div = document.createElement('div');
  div.className = 'list-item string-item';
  div.id = 'string-item-' + idx;
  div.innerHTML = '<wa-input name="strings" placeholder="e.g. E2" style="flex:1"></wa-input>'
    + '<wa-button type="button" variant="neutral" size="small" onclick="this.closest(\'.string-item\').remove()"><wa-icon name="xmark"></wa-icon></wa-button>';
  list.appendChild(div);
  div.querySelector('wa-input').focus();
}
</script>
