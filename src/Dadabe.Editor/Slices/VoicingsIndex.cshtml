@removeTagHelper *, *
@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.VoicingsIndexModel>
@using Dadabe.Editor.Slices
@{
    WriteLiteral(Dadabe.Editor.PageShell.Header);
}

<div class="page-content">
    <h4>Voicings</h4>
    <wa-card>
        <form hx-post="/api/voicings/run" hx-target="#result-panel" hx-swap="afterbegin"
              hx-indicator="#run-indicator" hx-sync="this:abort">

            <input type="hidden" name="tuning" id="form-tuning" />
            <input type="hidden" name="tuningName" id="form-tuning-name" />
            <div class="form-row">
                <wa-input label="Chord" name="chord" required placeholder="e.g. Dm7" style="flex:2"></wa-input>
                <wa-input label="Limit" name="limit" type="number" value="200" min="1" max="500" style="width:90px"></wa-input>
            </div>
            <div class="form-row" style="margin-top:0.5rem">
                <wa-input label="Next chords (top N)" name="topN" type="number" value="5" min="0" max="20" style="flex:1"></wa-input>
                <wa-input label="Entropy" name="entropy" type="number" value="0.5" min="0.01" max="10" step="0.01" style="flex:1"></wa-input>
            </div>

            <wa-details style="margin-top:0.75rem">
                <span slot="summary">Advanced options</span>
                @{ await RenderPartialAsync<VoicingOptionsFields, string>("vo-voicing-options"); }
            </wa-details>

            <div style="display:flex;justify-content:flex-end;align-items:center;gap:0.75rem;margin-top:0.75rem">
                <wa-spinner id="run-indicator" class="htmx-indicator"></wa-spinner>
                <wa-button type="submit" variant="brand">
                    <wa-icon slot="prefix" name="play"></wa-icon> Run
                </wa-button>
            </div>
        </form>
    </wa-card>

    <div id="result-panel"></div>
</div>

<script>
    window.bindTuningSelect();
</script>

@{
    WriteLiteral(Dadabe.Editor.PageShell.Footer);
}
