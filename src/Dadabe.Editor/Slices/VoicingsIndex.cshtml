@removeTagHelper *, *
@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.VoicingsIndexModel>
@using Dadabe.Editor.Slices
@{
    WriteLiteral(Dadabe.Editor.PageShell.Header);
}

<div class="padding">
    <h4>Voicings</h4>
    <article class="border">
        <div class="padding">
            <form hx-post="/api/voicings/run" hx-target="#result-panel" hx-swap="afterbegin"
                  hx-indicator="#run-indicator" hx-sync="this:abort">
                <div class="grid">
                    <div class="s12 m6 l4">
                        <div class="field label border">
                            <input type="text" name="chord" required />
                            <label>Chord</label>
                            <output>e.g. Dm7</output>
                        </div>
                    </div>
                    <div class="s12 m6 l3">
                        <div class="field suffix border">
                            <select name="tuning">
                                @if (Model.EmbeddedTunings.Count > 0)
                                {
                                    @foreach (var t in Model.EmbeddedTunings)
                                    {
                                        <option value="@t" @(t == "DADABE" ? "selected" : "")>@t</option>
                                    }
                                }
                                @if (Model.SavedTunings.Count > 0)
                                {
                                    @foreach (var t in Model.SavedTunings)
                                    {
                                        var spec = string.Join(",", t.Strings);
                                        <option value="@spec" data-name="@t.Name">@t.Name</option>
                                    }
                                }
                            </select>
                            <i>arrow_drop_down</i>
                            <label>Tuning</label>
                        </div>
                    </div>
                    <div class="s12 m3 l1">
                        <div class="field label border">
                            <input type="number" name="limit" value="200" min="1" max="500" />
                            <label>Limit</label>
                        </div>
                    </div>
                    <div class="s12 m3 l2">
                        <div class="field label border">
                            <input type="number" name="topN" value="5" min="0" max="20" />
                            <label>Next chords (top N)</label>
                        </div>
                    </div>
                    <div class="s12 m3 l1">
                        <div class="field label border">
                            <input type="number" name="entropy" value="0.5" min="0.01" max="10" step="0.01" />
                            <label>Entropy</label>
                        </div>
                    </div>
                    <div class="s12 m3 l1">
                        <div class="field label border">
                            <input type="number" name="minComfort" value="70" min="0" max="100" step="1" />
                            <label>Min comfort %</label>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="tuningName" id="tuning-name-field" />
                <nav class="right-align top-margin">
                    <span id="run-indicator" class="htmx-indicator"><i>hourglass_empty</i></span>
                    <button type="submit"><i>play_arrow</i> Run</button>
                </nav>
            </form>
            <script>
                            (function () {
                                var sel = document.querySelector('[name="tuning"]');
                                var nameField = document.getElementById('tuning-name-field');
                                function sync() {
                                    var opt = sel.options[sel.selectedIndex];
                                    nameField.value = opt.getAttribute('data-name') || opt.text;
                                }
                                sel.addEventListener('change', sync);
                                sync();
                            })();
            </script>
        </div>
    </article>
    <div id="result-panel"></div>
</div>

@{
    WriteLiteral(Dadabe.Editor.PageShell.Footer);
}
