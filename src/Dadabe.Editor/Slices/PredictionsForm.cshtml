@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.PredictionFormModel>

@{
  var p      = Model.Prediction;
  var isNew  = p is null;
  var slug   = p?.Slug ?? string.Empty;
  var method = isNew ? "post" : "put";
  var action = isNew ? "/api/predictions" : $"/api/predictions/{slug}";
}

<dialog class="active" id="prediction-dialog">
  <h5>@(isNew ? "New Prediction Request" : $"Edit: {p!.Name}")</h5>
  <form hx-@method="@action"
        hx-target="#prediction-list"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) document.getElementById('prediction-dialog').remove()">

    <div class="field label border">
      <input type="text" name="name" value="@(p?.Name ?? "")" required @(isNew ? "" : "readonly") />
      <label>Name</label>
    </div>
    <div class="field label border">
      <input type="text" name="chord" value="@(p?.Chord ?? "")" required placeholder="e.g. Dm7" />
      <label>Chord</label>
    </div>
    <div class="field label border">
      <select name="contextSlug">
        <option value="">— no context —</option>
        @foreach (var prog in Model.Progressions)
        {
          var selected = p?.ContextSlug == prog.Slug ? "selected" : "";
          <option value="@prog.Slug" @selected>@prog.Name</option>
        }
      </select>
      <label>Context progression (optional)</label>
    </div>
    <div class="field label border">
      <input type="number" name="maxResults" value="@(p?.MaxResults?.ToString() ?? "")" min="1" max="50" />
      <label>Max results (optional)</label>
    </div>
    <div class="field label border">
      <input type="number" name="entropy" value="@(p?.Entropy?.ToString() ?? "")" min="0.01" max="10" step="0.01" />
      <label>Entropy override (optional)</label>
    </div>

    <label>Filters</label>
    <div id="filter-list">
      @{
        var filters = p?.Filters ?? [];
        for (int i = 0; i < filters.Count; i++)
        {
          var f = filters[i];
          var paramKey = f.Type == "byChord" ? "chord" : "quality";
          var paramVal = f.Params.TryGetValue(paramKey, out var v) ? v : "";
          <div class="row filter-item" id="filter-item-@i">
            <div class="field border">
              <select name="filterType">
                <option value="byChord"   @(f.Type == "byChord"   ? "selected" : "")>byChord</option>
                <option value="byQuality" @(f.Type == "byQuality" ? "selected" : "")>byQuality</option>
              </select>
            </div>
            <div class="field border max">
              <input type="text" name="filterParam" value="@paramVal" placeholder="value" />
            </div>
            <button type="button" class="small border error" onclick="this.closest('.filter-item').remove()">
              <i>close</i>
            </button>
          </div>
        }
      }
    </div>
    <button type="button" class="small border" onclick="addFilter()">
      <i>add</i> Add filter
    </button>

    <nav class="right-align top-margin">
      <button type="button" class="border" onclick="document.getElementById('prediction-dialog').remove()">Cancel</button>
      <button type="submit">Save</button>
    </nav>
  </form>
</dialog>

<script>
function addFilter() {
  var list = document.getElementById('filter-list');
  var idx = list.children.length;
  var div = document.createElement('div');
  div.className = 'row filter-item';
  div.id = 'filter-item-' + idx;
  div.innerHTML = '<div class="field border"><select name="filterType"><option value="byChord">byChord</option><option value="byQuality">byQuality</option></select></div>'
    + '<div class="field border max"><input type="text" name="filterParam" placeholder="value" /></div>'
    + '<button type="button" class="small border error" onclick="this.closest(\'.filter-item\').remove()"><i>close</i></button>';
  list.appendChild(div);
}
</script>
