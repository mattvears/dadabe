@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.PredictionModel>>

@if (Model.Count == 0)
{
  <p class="italic">No prediction requests yet.</p>
}
else
{
  <table class="border">
    <thead>
      <tr><th>Name</th><th>Chord</th><th>Filters</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var p in Model)
      {
        <tr id="prediction-@p.Slug">
          <td>@p.Name</td>
          <td><code>@p.Chord</code></td>
          <td>@p.Filters.Count</td>
          <td class="no-wrap">
            <button class="small border"
                    hx-post="/api/predictions/@p.Slug/run"
                    hx-target="#result-panel"
                    hx-swap="innerHTML">
              <i>play_arrow</i>
            </button>
            <button class="small border"
                    hx-get="/api/predictions/@p.Slug/edit"
                    hx-target="#dialog-container"
                    hx-swap="innerHTML">
              <i>edit</i>
            </button>
            <button class="small border error"
                    hx-delete="/api/predictions/@p.Slug"
                    hx-target="#prediction-@p.Slug"
                    hx-swap="outerHTML"
                    hx-confirm="Delete '@p.Name'?">
              <i>delete</i>
            </button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
