@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.ModeModel>>

<div class="row bottom-margin">
  <span class="max"></span>
  <button hx-get="/api/reference/modes/new" hx-target="#dialog-container" hx-swap="innerHTML">
    <i>add</i> New
  </button>
</div>

@if (Model.Count == 0)
{
  <p class="italic">No modes yet.</p>
}
else
{
  <table class="border">
    <thead><tr><th>Name</th><th>Parent Scale</th><th>Intervals</th><th></th></tr></thead>
    <tbody>
      @foreach (var m in Model)
      {
        <tr id="mode-@m.Slug">
          <td>@m.Name</td>
          <td>@(m.ParentScale ?? "—")</td>
          <td>@string.Join(", ", m.Intervals)</td>
          <td class="no-wrap">
            <button class="small border"
                    hx-get="/api/reference/modes/@m.Slug/edit"
                    hx-target="#dialog-container" hx-swap="innerHTML">
              <i>edit</i>
            </button>
            <button class="small border error"
                    hx-delete="/api/reference/modes/@m.Slug"
                    hx-target="#mode-@m.Slug" hx-swap="outerHTML"
                    hx-confirm="Delete '@m.Name'?">
              <i>delete</i>
            </button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
