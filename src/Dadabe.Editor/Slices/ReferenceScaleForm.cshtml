@inherits RazorSlices.RazorSlice<Dadabe.Editor.Services.ScaleModel?>

@{
  var isNew        = Model is null;
  var slug         = Model?.Slug ?? string.Empty;
  var method       = isNew ? "post" : "put";
  var action       = isNew ? "/api/reference/scales" : $"/api/reference/scales/{slug}";
  var notesStr     = Model is null ? "" : string.Join(", ", Model.Notes);
  var intervalsStr = Model is null ? "" : string.Join(", ", Model.Intervals);
}

<wa-dialog id="scale-dialog" open label="@(isNew ? "New Scale" : $"Edit: {Model!.Name}")">
  <form hx-@method="@action"
        hx-target="#ref-content"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) document.getElementById('scale-dialog').hide()">

    <div class="form-field">
      <wa-input label="Name" name="name" value="@(Model?.Name ?? "")" required
                @(isNew ? "" : "readonly")></wa-input>
    </div>
    <div class="form-field">
      <wa-input label="Notes (comma-separated)" name="notes"
                value="@notesStr" required placeholder="e.g. C, D, E, F, G, A, B"></wa-input>
    </div>
    <div class="form-field">
      <wa-input label="Intervals (comma-separated semitones)" name="intervals"
                value="@intervalsStr" required placeholder="e.g. 0, 2, 4, 5, 7, 9, 11"></wa-input>
    </div>
    <div class="form-field">
      <wa-input label="Mode of (optional)" name="modeOf"
                value="@(Model?.ModeOf ?? "")"></wa-input>
    </div>
    <div class="form-field">
      <wa-input label="Description (optional)" name="description"
                value="@(Model?.Description ?? "")"></wa-input>
    </div>

    <div slot="footer" class="dialog-footer">
      <wa-button variant="neutral" onclick="document.getElementById('scale-dialog').hide()">Cancel</wa-button>
      <wa-button type="submit" variant="brand">Save</wa-button>
    </div>
  </form>
</wa-dialog>
