@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.PredictionResultModel>

<div class="result-card" style="margin-top:1rem">
  <div class="card-header">
    <span>
      <strong>
        Next chords after
        <code class="chord-link"
              hx-get="/api/voicings/fragment"
              hx-include="#pred-voicing-options"
              hx-vals='js:{"chord":"@Model.Chord","tuning":window.resolveVoicingTuning("pred-tuning-select")}'
              hx-target="next .voicing-panel-inline"
              hx-swap="innerHTML"
              onclick="window.selectChordRow(this)"
              title="Click to see voicings for @Model.Chord">@Model.Chord</code>
      </strong>
      @if (Model.ContextName is not null)
      {
        <span class="context-badge">
          context: @Model.ContextName
          @if (Model.ContextChords is { Count: > 0 })
          {
            <span style="margin-left:0.3rem;opacity:0.75">(@string.Join(" → ", Model.ContextChords))</span>
          }
        </span>
      }
    </span>
    <div style="display:flex;align-items:center;gap:0.5rem">
      @if (Model.AvailableTunings is { Count: > 0 })
      {
        <label style="font-size:0.8rem;color:#6b7280" for="pred-tuning-select">Voicings in:</label>
        <select id="pred-tuning-select" name="tuning"
                style="font-size:0.85rem;padding:2px 6px;border:1px solid #d1d5db;border-radius:4px">
          @foreach (var t in Model.AvailableTunings)
          {
            <option value="@t">@t</option>
          }
        </select>
      }
      <button onclick="this.closest('.result-card').remove()"
              style="border:1px solid #d1d5db;background:#fff;border-radius:4px;padding:2px 8px;cursor:pointer;font-size:0.85rem">
        ✕
      </button>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(Model.Error))
  {
    <p style="color:#dc2626">@Model.Error</p>
  }
  else if (Model.Results.Count == 0)
  {
    <p class="empty-state">No candidates survived the filters.</p>
  }
  else
  {
    <p class="form-hint" style="margin-bottom:0.75rem">
      Scores are softmax probabilities (sum to 1). Click a row to see voicings for that chord.
    </p>

    <table>
      <thead>
        <tr>
          <th style="width:100px">Chord</th>
          <th>Probability</th>
          <th style="width:60px;text-align:right">Score</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var r in Model.Results)
        {
          var pct = (int)Math.Round(r.Score * 100);
          var barW = (int)Math.Round(r.Score * 200);
          <tr class="pred-row"
              hx-get="/api/voicings/fragment"
              hx-include="#pred-voicing-options"
              hx-vals='js:{"chord":"@r.Chord","tuning":window.resolveVoicingTuning("pred-tuning-select")}'
              hx-target="next .voicing-panel-inline"
              hx-swap="innerHTML"
              onclick="window.selectChordRow(this)"
              style="cursor:pointer">
            <td><code>@r.Chord</code></td>
            <td>
              <div class="prob-cell">
                <div class="prob-bar" style="width:@(barW)px"></div>
                <span class="prob-pct">@pct%</span>
              </div>
            </td>
            <td style="text-align:right;font-variant-numeric:tabular-nums;font-size:0.85rem;color:#6b7280">
              @r.Score.ToString("F4")
            </td>
          </tr>
        }
      </tbody>
    </table>
  }

  <div class="voicing-panel-inline"></div>
</div>
