@inherits RazorSlices.RazorSlice<Dadabe.Editor.Services.ProgressionModel?>

@{
    var isNew = Model is null;
    var slug = Model?.Slug ?? string.Empty;
    var method = isNew ? "post" : "put";
    var action = isNew ? "/api/progressions" : $"/api/progressions/{slug}";
}

<wa-dialog id="progression-dialog" open label="@(isNew ? "New Progression" : $"Edit: {Model!.Name}")">
    <form hx-@method="@action" hx-target="#progression-list" hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) document.getElementById('dialog-container').innerHTML=''">

        <div class="form-field">
            <wa-input label="Name" name="name" value="@(Model?.Name ?? "")" required
                      @(isNew ? "" : "readonly")></wa-input>
        </div>
        <div class="form-field">
            <wa-input label="Tempo (optional)" name="tempo" type="number"
                      value="@(Model?.Tempo?.ToString() ?? "")" min="1" max="400"></wa-input>
        </div>

        <p>Chords</p>
        <div id="chord-list">
            @{
                var chords = Model?.Chords ?? [];
                for (int i = 0; i < chords.Count; i++)
                {
                    <div class="list-item chord-item" id="chord-item-@i">
                        <wa-input name="chords" value="@chords[i]" placeholder="e.g. Dm7" style="flex:1"></wa-input>
                        <wa-button type="button" variant="neutral" size="small"
                                   onclick="this.closest('.chord-item').remove()">
                            <wa-icon name="xmark"></wa-icon>
                        </wa-button>
                    </div>
                }
            }
        </div>
        <wa-button type="button" variant="neutral" size="small" onclick="addChord()">
            <wa-icon slot="prefix" name="plus"></wa-icon> Add chord
        </wa-button>

        <div slot="footer" class="dialog-footer">
            <wa-button type="button" variant="neutral" onclick="document.getElementById('dialog-container').innerHTML=''">Cancel</wa-button>
            <wa-button type="submit" variant="brand">Save</wa-button>
        </div>
    </form>
</wa-dialog>

<script>
    function addChord() {
        var list = document.getElementById('chord-list');
        var idx = list.children.length;
        var div = document.createElement('div');
        div.className = 'list-item chord-item';
        div.id = 'chord-item-' + idx;
        div.innerHTML = '<wa-input name="chords" placeholder="e.g. Dm7" style="flex:1"></wa-input>'
            + '<wa-button type="button" variant="neutral" size="small" onclick="this.closest(\'.chord-item\').remove()"><wa-icon name="xmark"></wa-icon></wa-button>';
        list.appendChild(div);
        div.querySelector('wa-input').focus();
    }
</script>
