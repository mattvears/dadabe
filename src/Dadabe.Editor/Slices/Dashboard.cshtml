@removeTagHelper *, *
@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.DashboardModel>
@using Dadabe.Editor.Slices
@{ WriteLiteral(Dadabe.Editor.PageShell.Header); }

<div class="page-content">
  <h4>Dashboard</h4>
  <div class="card-grid">
    <wa-card>
      <h5>@Model.ProgressionCount</h5>
      <p>Progressions</p>
      <wa-button href="/progressions" variant="neutral" size="small">Open</wa-button>
    </wa-card>
    <wa-card>
      <h5>@Model.PredictionCount</h5>
      <p>Predictions</p>
      <wa-button href="/predictions" variant="neutral" size="small">Open</wa-button>
    </wa-card>
    <wa-card>
      <h5>@Model.TuningCount</h5>
      <p>Tunings</p>
      <wa-button href="/tunings" variant="neutral" size="small">Open</wa-button>
    </wa-card>
    <wa-card>
      <h5>@Model.ReferenceCount</h5>
      <p>Reference items</p>
      <wa-button href="/reference" variant="neutral" size="small">Open</wa-button>
    </wa-card>
  </div>
</div>

@{ WriteLiteral(Dadabe.Editor.PageShell.Footer); }
