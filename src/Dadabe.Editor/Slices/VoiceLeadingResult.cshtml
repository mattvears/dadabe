@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.VoiceLeadResultModel>
@using Dadabe.Editor.Slices

<wa-card style="margin-top:1rem">
    <div class="card-header">
        <strong>@Model.Chords [@Model.TuningName]</strong>
        <wa-button size="small" variant="neutral" onclick="this.closest('wa-card').remove()">
            <wa-icon name="xmark"></wa-icon>
        </wa-button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p style="color:var(--wa-color-danger-600)">@Model.Error</p>
    }
    else
    {
        @foreach (var sol in Model.Solutions)
        {
            <wa-card style="margin-bottom:0.75rem">
                <div class="card-header">
                    <p style="margin:0"><strong>Solution @sol.SolutionNumber</strong> — total distance: @sol.TotalDistance frets</p>
                    @if (Model.SongSlug is not null && Model.SectionId is not null)
                    {
                        var stepsJson = System.Text.Json.JsonSerializer.Serialize(
                            sol.Steps.Select(st => new
                            {
                                symbol = st.Chord,
                                bars = st.Bars,
                                comfortPct = st.ComfortPct,
                                structure = st.Structure,
                                positions = st.Positions!.Select(p => new { @string = p.String, fret = p.Fret, muted = p.Muted, open = p.Open }),
                            }));
                        <wa-button size="small" variant="brand" appearance="outlined"
                                onclick="window.applyVoiceLead(this)"
                                data-slug="@Model.SongSlug"
                                data-section="@Model.SectionId"
                                data-steps='@stepsJson'
                                title="Replace this section's pinned voicings with this solution">
                            <wa-icon slot="prefix" name="thumbtack"></wa-icon> Replace pinned voicings
                        </wa-button>
                    }
                </div>
                <div class="apply-status form-hint"></div>

                @{ var diagrammed = sol.Steps.Where(s => s.Diagram is not null).ToList(); }
                @if (diagrammed.Count > 0)
                {
                    <div class="song-chart-slots" style="margin-bottom:0.75rem">
                        @foreach (var step in diagrammed)
                        {
                            <div class="song-chart-slot">
                                <div class="song-chart-chord"><code>@step.Chord</code></div>
                                @{ await RenderPartialAsync<ChordDiagramPartial, ChordDiagram>(step.Diagram!); }
                            </div>
                        }
                    </div>
                }

                <table>
                    <thead>
                        <tr>
                            <th>Chord</th>
                            <th>ASCII</th>
                            <th>Structure</th>
                            <th>Comfort</th>
                            <th>Distance</th>
                            <th>Move</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in sol.Steps)
                        {
                            <tr>
                                <td><code>@step.Chord</code></td>
                                <td><code>@step.AsciiNotation</code></td>
                                <td>
                                    <abbr title="@Dadabe.Editor.Services.VoicingStructureGlossary.Describe(step.Structure)">@step.Structure</abbr>
                                </td>
                                <td>@step.ComfortPct%</td>
                                <td>@(step.TransitionDistance.HasValue ? $"{step.TransitionDistance} frets" : "—")</td>
                                <td class="small">@Dadabe.Editor.Services.VoiceMoveSummary.Describe(step.Moves, Model.StringCount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </wa-card>
        }
    }
</wa-card>
