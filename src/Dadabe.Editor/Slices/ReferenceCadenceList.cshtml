@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.CadenceModel>>

<div class="list-header">
  <span></span>
  <wa-button hx-get="/api/reference/cadences/new" hx-target="#dialog-container" hx-swap="innerHTML">
    <wa-icon slot="prefix" name="plus"></wa-icon> New
  </wa-button>
</div>

@if (Model.Count == 0)
{
  <p class="empty-state">No cadences yet.</p>
}
else
{
  <table>
    <thead><tr><th>Type</th><th>Resolution</th><th>Example</th><th></th></tr></thead>
    <tbody>
      @foreach (var c in Model)
      {
        <tr id="cadence-@c.Slug">
          <td>@c.Type</td>
          <td>@(c.Resolution ?? "—")</td>
          <td>@string.Join(", ", c.ExampleProgression)</td>
          <td class="no-wrap">
            <wa-button size="small" variant="neutral"
                    hx-get="/api/reference/cadences/@c.Slug/edit"
                    hx-target="#dialog-container" hx-swap="innerHTML">
              <wa-icon name="pencil"></wa-icon>
            </wa-button>
            <wa-button size="small" variant="danger"
                    hx-delete="/api/reference/cadences/@c.Slug"
                    hx-target="#cadence-@c.Slug" hx-swap="outerHTML"
                    hx-confirm="Delete this cadence?">
              <wa-icon name="trash"></wa-icon>
            </wa-button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
