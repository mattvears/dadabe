@inherits RazorSlices.RazorSlice<Dadabe.Editor.Services.CadenceModel?>

@{
  var isNew  = Model is null;
  var slug   = Model?.Slug ?? string.Empty;
  var method = isNew ? "post" : "put";
  var action = isNew ? "/api/reference/cadences" : $"/api/reference/cadences/{slug}";
}

<dialog class="active" id="cadence-dialog">
  <h5>@(isNew ? "New Cadence" : "Edit Cadence")</h5>
  <form hx-@method="@action"
        hx-target="#ref-content"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) document.getElementById('cadence-dialog').remove()">

    <div class="field label border">
      <select name="type">
        @foreach (var t in new[] { "authentic", "plagal", "deceptive", "half" })
        {
          <option value="@t" @(Model?.Type == t ? "selected" : "")>@t</option>
        }
      </select>
      <label>Type</label>
    </div>
    <div class="field label border">
      <input type="text" name="resolution" value="@(Model?.Resolution ?? "")" placeholder="e.g. V->I" />
      <label>Resolution (optional)</label>
    </div>
    <div class="field label border">
      <input type="text" name="description" value="@(Model?.Description ?? "")" />
      <label>Description (optional)</label>
    </div>

    <label>Example Progression</label>
    <div id="chord-list">
      @{
        var chords = Model?.ExampleProgression ?? [];
        for (int i = 0; i < chords.Count; i++)
        {
          <div class="row chord-item" id="chord-item-@i">
            <div class="field border max">
              <input type="text" name="chords" value="@chords[i]" placeholder="e.g. G7" />
            </div>
            <button type="button" class="small border error" onclick="this.closest('.chord-item').remove()">
              <i>close</i>
            </button>
          </div>
        }
      }
    </div>
    <button type="button" class="small border" onclick="addChord()"><i>add</i> Add chord</button>

    <nav class="right-align top-margin">
      <button type="button" class="border" onclick="document.getElementById('cadence-dialog').remove()">Cancel</button>
      <button type="submit">Save</button>
    </nav>
  </form>
</dialog>

<script>
function addChord() {
  var list = document.getElementById('chord-list');
  var idx = list.children.length;
  var div = document.createElement('div');
  div.className = 'row chord-item';
  div.id = 'chord-item-' + idx;
  div.innerHTML = '<div class="field border max"><input type="text" name="chords" placeholder="e.g. G7" /></div>'
    + '<button type="button" class="small border error" onclick="this.closest(\'.chord-item\').remove()"><i>close</i></button>';
  list.appendChild(div);
  div.querySelector('input').focus();
}
</script>
