@removeTagHelper *, *
@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.TuningModel>>
@using Dadabe.Editor.Slices
@{ WriteLiteral(Dadabe.Editor.PageShell.Header); }

<div class="page-content">
  <div class="page-header">
    <h4>Tunings</h4>
    <wa-button hx-get="/api/tunings/new" hx-target="#dialog-container" hx-swap="innerHTML">
      <wa-icon slot="prefix" name="plus"></wa-icon> New
    </wa-button>
  </div>
  <div id="tuning-list">
    @{ await RenderPartialAsync<TuningsList, System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.TuningModel>>(Model); }
  </div>
</div>
<div id="dialog-container"></div>

@{ WriteLiteral(Dadabe.Editor.PageShell.Footer); }
