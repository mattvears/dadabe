@removeTagHelper *, *
@inherits RazorSlices.RazorSlice<Dadabe.Editor.Slices.VoiceLeadIndexModel>
@using Dadabe.Editor.Slices
@{
    WriteLiteral(Dadabe.Editor.PageShell.Header);
}

<div class="page-content">
    <h4>Voice Lead</h4>
    <wa-card>
        <form hx-post="/api/voiceleading/run" hx-target="#result-panel" hx-swap="afterbegin"
              hx-indicator="#vl-indicator" hx-sync="this:abort">

            <input type="hidden" name="tuning" id="form-tuning" />
            <input type="hidden" name="tuningName" id="form-tuning-name" />
            <input type="hidden" name="songSlug" id="form-song" />
            <input type="hidden" name="sectionId" id="form-section" />
            <div class="form-field">
                <wa-textarea label="Chords" name="chords" rows="3"
                             placeholder="Cmaj7 Am7 Dm7 G7  (space or newline separated)"></wa-textarea>
            </div>
            <div class="form-row" style="align-items:center">
                <wa-checkbox name="useActiveSection" value="true">
                    Use the active song section (top right) instead of the chords above
                </wa-checkbox>
            </div>
            <p class="form-hint" style="margin:0.25rem 0 0">
                When checked, chords, bars, and tuning come from the active song section's own chart —
                the result can then be pushed straight back into that section.
            </p>
            <div class="form-row">
                <wa-input label="Solutions" name="solutions" type="number" value="1" min="1" max="5" style="width:110px"></wa-input>
                <wa-input label="Min comfort %" name="minComfort" type="number" value="70" min="0" max="100" style="width:130px"></wa-input>
            </div>

            <div style="display:flex;justify-content:flex-end;align-items:center;gap:0.75rem;margin-top:0.75rem">
                <wa-spinner id="vl-indicator" class="htmx-indicator"></wa-spinner>
                <wa-button type="submit" variant="brand">
                    <wa-icon slot="prefix" name="play"></wa-icon> Find paths
                </wa-button>
            </div>
        </form>
    </wa-card>

    <wa-details style="margin-top:1rem">
        <span slot="summary">About voice leading</span>
        <div style="max-width:640px">
            <p><strong>Minimal-motion voice leading</strong> finds the sequence of chord voicings across a
            progression that minimises total finger travel across the neck.</p>
            <p>On guitar, smooth voice leading reduces hand fatigue and creates cleaner transitions between
            chords — the same principle used in classical four-part writing.</p>
            <p>The <strong>distance metric</strong> is the sum of absolute fret changes per string between
            consecutive voicings. Muted strings use −1 as a sentinel so a muted↔fretted move counts as a
            full-span move.</p>
            <p>When <strong>Solutions &gt; 1</strong>, an A* search with exact backward-DP cost-to-go
            heuristic enumerates the k cheapest distinct paths through the progression graph.</p>
        </div>
    </wa-details>

    <div id="result-panel"></div>
</div>

<script>
    window.bindTuningSelect();
    window.bindSongSelect();
</script>

@{
    WriteLiteral(Dadabe.Editor.PageShell.Footer);
}
