@inherits RazorSlices.RazorSlice<System.Collections.Generic.IReadOnlyList<Dadabe.Editor.Services.ProgressionModel>>

@if (Model.Count == 0)
{
  <p class="empty-state">No progressions yet. Click <strong>New</strong> to add one.</p>
}
else
{
  <table>
    <thead>
      <tr><th>Name</th><th>Chords</th><th>Tempo</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var p in Model)
      {
        <tr id="progression-@p.Slug">
          <td>@p.Name</td>
          <td>@string.Join(", ", p.Chords)</td>
          <td>@(p.Tempo?.ToString() ?? "—")</td>
          <td class="no-wrap">
            <wa-button size="small" variant="brand" appearance="outlined"
                    hx-get="/api/progressions/@p.Slug/transform"
                    hx-target="#dialog-container"
                    hx-swap="innerHTML"
                    title="Transform">
              <wa-icon name="shuffle"></wa-icon>
            </wa-button>
            <wa-button size="small" variant="neutral"
                    hx-get="/api/progressions/@p.Slug/edit"
                    hx-target="#dialog-container"
                    hx-swap="innerHTML">
              <wa-icon name="pencil"></wa-icon>
            </wa-button>
            <wa-button size="small" variant="danger"
                    hx-delete="/api/progressions/@p.Slug"
                    hx-target="#progression-@p.Slug"
                    hx-swap="outerHTML"
                    hx-confirm="Delete '@p.Name'?">
              <wa-icon name="trash"></wa-icon>
            </wa-button>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
