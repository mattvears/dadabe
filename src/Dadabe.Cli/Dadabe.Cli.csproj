<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dadabe</AssemblyName>
    <RootNamespace>Dadabe.Cli</RootNamespace>
    <!-- DTOs intentionally use the domain term "String" for fretboard strings. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dadabe.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dadabe.Core\Dadabe.Core.csproj" />
    <ProjectReference Include="..\Dadabe.Fretboard\Dadabe.Fretboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\envelope.schema.json">
      <Link>schemas\envelope.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.envelope.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\prediction-result.schema.json">
      <Link>schemas\prediction-result.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.prediction-result.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\voicings.schema.json">
      <Link>schemas\voicings.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.voicings.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\tuning.schema.json">
      <Link>schemas\tuning.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.tuning.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\chord.schema.json">
      <Link>schemas\chord.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.chord.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\voice-lead-result.schema.json">
      <Link>schemas\voice-lead-result.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.voice-lead-result.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\transform-result.schema.json">
      <Link>schemas\transform-result.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.transform-result.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\transformation.schema.json">
      <Link>schemas\transformation.schema.json</Link>
      <LogicalName>Dadabe.Cli.schemas.transformation.schema.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
