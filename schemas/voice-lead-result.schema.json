{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadabe.dev/schemas/voice-lead-result.schema.json",
  "title": "VoiceLeadingResult",
  "type": "object",
  "description": "Response shape for the voice-lead subcommand.",
  "required": ["tool", "version", "schemaVersion", "command", "input", "data", "warnings"],
  "additionalProperties": false,
  "properties": {
    "tool":          { "const": "dadabe" },
    "version":       { "type": "string" },
    "schemaVersion": { "const": "1" },
    "command":       { "const": "voice-lead" },
    "input":         { "type": "object" },
    "warnings":      { "type": "array", "items": { "type": "string" } },
    "data": {
      "type": "object",
      "required": ["chords", "tuning", "solutions"],
      "additionalProperties": false,
      "properties": {
        "chords":  { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tuning":  { "type": "string" },
        "solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["totalDistance", "steps"],
            "additionalProperties": false,
            "properties": {
              "totalDistance": { "type": "integer", "minimum": 0 },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["chord", "voicing"],
                  "additionalProperties": false,
                  "properties": {
                    "chord":   { "type": "string" },
                    "voicing": { "type": "object" },
                    "transition": {
                      "type": "object",
                      "required": ["totalDistance", "moves"],
                      "additionalProperties": false,
                      "properties": {
                        "totalDistance": { "type": "integer", "minimum": 0 },
                        "moves": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["string", "distance"],
                            "additionalProperties": false,
                            "properties": {
                              "string":   { "type": "integer", "minimum": 0 },
                              "from":     { "type": ["integer", "null"] },
                              "to":       { "type": ["integer", "null"] },
                              "distance": { "type": "integer", "minimum": 0 }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
